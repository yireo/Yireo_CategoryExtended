{
    "name": "yireo/magento2-category-extended",
    "license": "OSL-3.0",
    "version": "0.1.1",
    "type": "magento2-module",
    "description": "Allow for categories (in the main menu) to point towards CMS Pages and Custom URLs",
    "keywords": [
        "magento2",
        "magento2-module",
        "yireo",
        "menu"
    ],
    "authors": [
        {
            "name": "Jisse Reitsma (Yireo)",
            "email": "jisse@yireo.com",
            "homepage": "https://yireo.com/"
        },
        {
            "name": "Ruud van Zuidam (Siteation)",
            "email": "info@siteation.dev",
            "homepage": "https://siteation.dev/"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "ext-pcre": "*",
        "magento/framework": "^101.0 | ^102.0 | ^103.0",
        "magento/module-catalog": "^102.0 | ^103.0 | ^104.0",
        "magento/module-cms": "^104.0",
        "magento/module-eav": "^102.1",
        "magento/module-sitemap": "^100.4",
        "magento/module-store": "^101.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\CategoryExtended\\": ""
        }
    }
}
